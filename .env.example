# Sem BACKEND_URL, a loja usa o catálogo de demonstração (sem login/pedidos reais).
# Para integrar ao Railway, copie este arquivo para .env.local:
# Preencha com a URL do seu serviço; não salve o endereço real neste exemplo.
BACKEND_URL=

# URL pública do front em produção, usada para validar login e outras ações.
# Localmente, deixe vazio. Na Netlify, configure no escopo Functions/runtime.
APP_URL=

# Valores iguais a CLIENT_ID e CLIENT_SECRET do Spring. Apenas no servidor Next.js.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
